<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TradingStuff.Contracts\TradingStuff.Contracts.csproj" />
    <ProjectReference Include="..\TradingStuff.ResearchContracts\TradingStuff.ResearchContracts.csproj" />
    <ProjectReference Include="..\TradingStuff.ServiceDefaults\TradingStuff.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Migrations ship inside the binary and are applied in name order by MigrationRunner. -->
    <EmbeddedResource Include="Persistence\Migrations\*.sql" />
    <!-- Holiday/closure data ships with the generator that reads it, for the same reason: the
         sessions every downstream consumer is validated against must not be able to drift from the
         binary that produced them. -->
    <EmbeddedResource Include="Sessions\exchange-calendars.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TradingStuff.Tests" />
  </ItemGroup>

  <!-- Build the React ClientApp before the main build target -->
  <Target Name="BuildClientApp" BeforeTargets="Build">
    <!-- Ensure directories exist -->
    <MakeDir Directories="$(IntermediateOutputPath)staticwebassets" />
    <Exec Command="npm ci" WorkingDirectory="ClientApp" />
    <Exec Command="npm run build" WorkingDirectory="ClientApp" />
  </Target>

</Project>
